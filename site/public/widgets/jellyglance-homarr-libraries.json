{
  "$schema": "homarr-custom-widget-v2",
  "name": "JellyGlance libraries",
  "description": "Per-library sizes from JellyGlance.",
  "iconUrl": "https://jellyglance.com/project-logo.png",
  "url": "http://jellyglance:3000/api/widgets/libraries",
  "authType": "apiKeyHeader",
  "headerName": "x-api-token",
  "method": "GET",
  "displayType": "customJsx",
  "displayConfig": {
    "type": "customJsx",
    "template": "<Stack gap=\"xs\" p=\"xs\" h=\"100%\">\n  <Group justify=\"space-between\" align=\"center\" wrap=\"nowrap\" gap=\"xs\" pr={36}>\n    <Group gap=\"xs\" wrap=\"nowrap\" miw={0}>\n      <Avatar src=\"https://jellyglance.com/project-logo.png\" size={24} radius=\"xl\" />\n      <Stack gap={0} miw={0}>\n        <Text fw={800} size=\"sm\" truncate>Libraries</Text>\n        <Text size=\"xs\" c=\"dimmed\" truncate>{data.totalLabel}</Text>\n      </Stack>\n    </Group>\n    <Box style={{ flexShrink: 0 }}><Badge variant=\"light\" color=\"violet\">{data.totalLabel}</Badge></Box>\n  </Group>\n  <Stack gap=\"sm\" flex={1} mih={0} style={{ overflowY: \"auto\" }}>\n  <Table striped>\n    <Table.Thead>\n      <Table.Tr>\n        <Table.Th>Library</Table.Th>\n        <Table.Th>Size</Table.Th>\n        <Table.Th>Items</Table.Th>\n      </Table.Tr>\n    </Table.Thead>\n    <Table.Tbody>\n      {data.libraries.map((row) =>\n        <Table.Tr>\n          <Table.Td>{row.name}</Table.Td>\n          <Table.Td>{row.size}</Table.Td>\n          <Table.Td>{row.items}</Table.Td>\n        </Table.Tr>\n      )}\n    </Table.Tbody>\n  </Table>\n  </Stack>\n</Stack>"
  }
}
