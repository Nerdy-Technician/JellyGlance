{
  "name": "jellyglance",
  "version": "1.2.8",
  "private": true,
  "description": "JellyGlance - a modern Jellyfin analytics and media control dashboard by Nerdy-Technician.",
  "keywords": [
    "jellyfin",
    "jellyfin-dashboard",
    "media-server",
    "self-hosted",
    "analytics",
    "playback-statistics",
    "quick-connect",
    "sonarr",
    "radarr",
    "lidarr",
    "bazarr",
    "qbittorrent",
    "docker",
    "postgresql",
    "react"
  ],
  "homepage": "https://jellyglance.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nerdy-Technician/JellyGlance.git"
  },
  "bugs": {
    "url": "https://github.com/Nerdy-Technician/JellyGlance/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @jellyglance/api\" \"npm run dev -w @jellyglance/web\"",
    "dev:web": "npm run dev -w @jellyglance/web",
    "dev:api": "npm run dev -w @jellyglance/api",
    "build": "npm run build -w @jellyglance/web",
    "i18n:check": "node scripts/i18n-sync.mjs --check",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "lint": "npm run lint -w @jellyglance/web",
    "bundle:budget": "node scripts/check-bundle-budget.cjs",
    "bundle:budget:update": "npm run build && node scripts/check-bundle-budget.cjs --update",
    "start": "npm run start -w @jellyglance/api",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "concurrently": "^10.0.5",
    "semantic-release": "^25.0.9"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "^12.0.2"
    },
    "eslint": "10.11.0",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "qs": "6.16.0",
    "vite@5.4.21": "6.4.3",
    "esbuild@0.21.5": "0.25.12",
    "npm": {
      "undici": "6.28.0",
      "brace-expansion": "5.0.9",
      "tar": "7.5.21",
      "ip-address": "10.2.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
