{
  "name": "jellyglance",
  "version": "1.2.2-beta.1",
  "private": true,
  "description": "JellyGlance - a modern Jellyfin analytics and media control dashboard by Nerdy-Technician.",
  "keywords": [
    "jellyfin",
    "jellyfin-dashboard",
    "media-server",
    "self-hosted",
    "analytics",
    "playback-statistics",
    "quick-connect",
    "sonarr",
    "radarr",
    "lidarr",
    "bazarr",
    "qbittorrent",
    "docker",
    "postgresql",
    "react"
  ],
  "homepage": "https://jellyglance.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nerdy-Technician/JellyGlance.git"
  },
  "bugs": {
    "url": "https://github.com/Nerdy-Technician/JellyGlance/issues"
  },
  "license": "GPL-3.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "docs"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @jellyglance/api\" \"npm run dev -w @jellyglance/web\"",
    "dev:web": "npm run dev -w @jellyglance/web",
    "dev:api": "npm run dev -w @jellyglance/api",
    "build": "npm run build -w @jellyglance/web",
    "build:docs": "npm run build -w @jellyglance/docs",
    "docs:dev": "npm run dev -w @jellyglance/docs",
    "i18n:check": "node scripts/i18n-sync.mjs --check",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "lint": "npm run lint -w @jellyglance/web",
    "start": "npm run start -w @jellyglance/api",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "concurrently": "^9.2.1",
    "semantic-release": "^25.0.9"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "^12.0.2"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
